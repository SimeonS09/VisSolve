      m_Calls: []
  m_text: "Potenzen werden dargestellt, indem der Strich, der die <color=#0020FFFF>Basis</color>
    darstellt, horizontal ausgelegt wird und zu einer Kathete eines rechtwinkligen
    Dreiecks wird. Die andere Kathete hat die L\xE4nge 1. Anschliessend wird der
    Strich, der den <color=#32CD36FF>Exponenten</color> darstellt, vertikal darunter
    angef\xFCgt. Nun bewegt sich das Dreieck nach unten. Dabei macht es immer in
    Einer-Schritten Kopien von sich selbst, also immer, wenn die obere Spitze des
    Dreiecks die letzte Kopie der <color=#0020FFFF>Basis</color> ber\xFChrt. Dadurch
    entstehen so viele Kopien der <color=#0020FFFF>Basis</color>, wie es dem Wert
    des <color=#32CD36FF>Exponenten</color> entspricht."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
