  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Das k\xF6nnen wir jedoch auch mit dem Ergebnis dieser Division machen,
    indem wir daran ein \xE4hnliches Dreieck h\xE4ngen. Wiederholen wir diesen Vorgang
    so oft, wie die Anzahl des Wurzelexponenten, so zeichnet sich eine Art Schneckenhaus
    ab. Ausserdem erhalten wir ein <color=#32CD36FF>Ergebnis</color> dieser wiederholten
    Division. Nun wissen wir aber: Wenn dieses <color=#32CD36FF>Ergebnis</color>
    1 ist, zeigen die Dreiecke eine Division mit dem Divisor, welcher dem <color=#FF10CBFF>Resultat</color>
    der Wurzel entspricht. Wir m\xFCssen also nur die <color=#E79C19>Winkel</color>
    so anpassen, dass dieses <color=#32CD36FF>Ergebnis</color> zu 1 wird, und k\xF6nnen
    am letzten Zwischenergebnis unser <color=#FF10CBFF>Resultat</color> ablesen,
    da nur dieses dividiert durch sich selbst 1 ergibt."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
