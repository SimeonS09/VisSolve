  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Bei einer Addition zweier Zahlen mit unterschiedlichen Vorzeichen wird
    der <color=#11A000FF>zweite Summand </color>auch an das Ende des <color=#FFFF00FF>ersten
    Summanden </color>angeh\xE4ngt, aber dieser zeigt nun in die entgegengesetzte
    Richtung. \nDie Linie, welche die <color=#FF0000FF>Summe </color>darstellt, wird
    vom Anfangspunkt des <color=#FFFF00FF>ersten Summanden</color> bis zum Ende des
    <color=#11A000FF>zweiten</color> gezogen. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
