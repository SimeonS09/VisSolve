  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Als n\xE4chstes wird der <color=#32CD36FF>zweite Faktor</color> parallel
    zur ersten Hilfslinie eingezeichnet. Das Dreieck wird nun zentrisch gestreckt,
    bis der <color=#32CD36FF>zweite Faktor</color> die Seite des neuen Dreiecks darstellt.
    Da diese Seite zuvor die L\xE4nge 1 hatte, wurde das ganze Dreieck um den <color=#32CD36FF>zweiten
    Faktor</color> gestreckt. So auch die andere Seite, welche zuvor der <color=#0020FFFF>erste
    Faktor</color> war. Diese Seite des gestreckten Dreiecks zeigt nun das <color=#FF10CBFF>Produkt
    </color>an, da die originale \nL\xE4nge, also der <color=#0020FFFF>erste Faktor</color>,\n
    um den <color=#32CD36FF>zweiten Faktor</color>\n gestreckt wurde."
  m_isRightToLeft: 0
