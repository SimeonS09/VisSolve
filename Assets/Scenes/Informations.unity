  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Als n\xE4chstes wird eine Einheitslinie parallel zum <color=#32CD36FF>Divisor</color>
    eingezeichnet. Das Dreieck wird nun zentrisch gestaucht, bis diese neue Hilfslinie
    die Seite des neuen Dreiecks darstellt. Da dieses Dreieck die Seitenl\xE4nge
    1 hat, muss es um den Faktor des <color=#32CD36FF>Divisors</color> gestaucht
    werden. Analog dazu auch die andere Seite, welche zuvor der <color=#0020FFFF>Dividend</color>
    war. Diese Seite des gestreckten Dreiecks zeigt nun den <color=#FF10CBFF>Quotienten</color>
    an, da die originale L\xE4nge des <color=#0020FFFF>Dividenden</color> um den
    Faktoren des <color=#32CD36FF>Divisors</color> gestaucht wurde."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
