  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Bei einem <color=#32CD36FF>Divisor</color>, der kleiner als 1 ist, passiert
    etwas Spannendes: Das Dreieck muss nun gestreckt werden, um die eine Seite eine
    Einheit lang zu machen. Dabei wird auch der Strich des <color=#0020FFFF>Dividenden</color>
    l\xE4nger, was aber Sinn ergibt, wenn man bedenkt, dass eine Division mit einem
    <color=#32CD36FF>Divisor</color> kleiner als 1 immer einen gr\xF6sseren <color=#FF10CBFF>Quotienten</color>
    hat, als sein <color=#0020FFFF>Dividend</color> ist."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
