      m_Calls: []
  m_text: "Um die Darstellung von Wurzeln zu verstehen, ist es wichtig, dass einem
    bewusst ist, dass ein Dreieck eine Art von Division um einen gewissen Divisor
    ist. Da bei \xE4hnlichen Dreiecken die <color=#FF0000FF>eine Kathete</color>
    im Verh\xE4ltnis immer gleich zu der <color=#11A000FF>anderen Kathete</color>
    ist, kann <color=#FF0000FF>diese</color> an einen Strich angef\xFCgt werden,
    und an der <color=#11A000FF>anderen</color> den <color=#11A000FF>Quotienten</color>
    abgelesen werden, abh\xE4ngig vom Winkel des Dreiecks, welcher den <color=#FFFF00FF>Dividenden</color>
    bestimmt. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
